[Defines]
  INF_VERSION                    = 0x00010006
  BASE_NAME                      = BootPkg
  FILE_GUID                      = 12345678-1234-1234-1234-123456789ABC
  MODULE_TYPE                    = UEFI_APPLICATION
  ENTRY_POINT                    = UefiMain

[Sources]
  Boot.c
  BootSerial.c
  BootVideo.c
  BootVideoScore.c
  BootVideoEdid.c
  BootVideoTheme.c
  BootLoadKernel.c
  BootFillRsdp.c
  BootFillXhci.c
  JumpToKernel.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiApplicationEntryPoint
  MemoryAllocationLib
  BaseMemoryLib
  BaseLib
  DebugLib
  PcdLib
  PrintLib
  DevicePathLib
  RegisterFilterLib

[Guids]
  gEfiFileInfoGuid
  gEfiAcpiTableGuid
  gEfiAcpi10TableGuid

[Protocols]
  gEfiGraphicsOutputProtocolGuid
  gEfiEdidActiveProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
  gEfiLoadedImageProtocolGuid
  gEfiPciIoProtocolGuid
